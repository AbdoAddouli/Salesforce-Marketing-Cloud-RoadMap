<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>Preference centre consent capture. Writes an evidenced consent decision per channel and purpose. An opt-out path always wins: once a channel is opted out, this flow cannot write an opt-in over it without a fresh submission timestamp.</description>
    <environments>Default</environments>
    <interviewLabel>Consent Capture {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Consent Capture and Preference Centre</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>ScreenFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Already_Suppressed</targetReference>
        </connector>
    </start>
    <decisions>
        <name>Already_Suppressed</name>
        <label>Is this contact already opted out?</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <defaultConnectorLabel>No opt-out on file</defaultConnectorLabel>
        <defaultConnector>
            <targetReference>Capture_Consent</targetReference>
        </defaultConnector>
        <connector>
            <targetReference>Block_Re_Opt_In</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RecordId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>contactId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Opted_Out__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <label>Is this contact already opted out?</label>
    </decisions>
    <assignments>
        <name>Capture_Consent</name>
        <label>Write the evidenced consent decision</label>
        <locationX>176</locationX>
        <locationY>334</locationY>
        <assignmentItems>
            <assignToReference>consentRecord.Contact__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>contactId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>consentRecord.CapturedDate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>consentRecord.RecordedBy__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$User.Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>consentRecord.Evidence__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Evidence__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Save_Consent</targetReference>
        </connector>
    </assignments>
    <recordCreates>
        <name>Save_Consent</name>
        <label>Save consent decision</label>
        <locationX>176</locationX>
        <locationY>454</locationY>
        <connector>
            <targetReference>Write_Suppression</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Fault_Path</targetReference>
        </faultConnector>
        <inputReference>consentRecord</inputReference>
    </recordCreates>
    <assignments>
        <name>Write_Suppression</name>
        <label>Confirm the resolved state to the visitor</label>
        <locationX>176</locationX>
        <locationY>578</locationY>
        <assignmentItems>
            <assignToReference>outcome</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Saved</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Done</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Block_Re_Opt_In</name>
        <label>Terminal opt-out, do not overwrite</label>
        <locationX>528</locationX>
        <locationY>158</locationY>
        <assignmentItems>
            <assignToReference>outcome</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Blocked: an opt-out is on file. Only a new submission from the person can change this.</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Done</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Fault_Path</name>
        <label>Log the failure</label>
        <locationX>176</locationX>
        <locationY>700</locationY>
        <assignmentItems>
            <assignToReference>outcome</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Done</targetReference>
        </connector>
    </assignments>
    <variables>
        <name>contactId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>channel</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>purpose</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>optIn</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isInputDefault>true</isInputDefault>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>Evidence__c</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>Opted_Out__c</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>consentRecord</name>
        <dataType>Consent_Preference__c</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>outcome</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <statuses>
        <name>Done</name>
        <label>Done</label>
        <category>
            <name>Success</name>
        </category>
    </statuses>
</Flow>
